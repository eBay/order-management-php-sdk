{
  "cases": [
    {
      "label": "with values",
      "input": {
        "contractCancellationReason": "BUYER_REQUESTED",
        "purchaseQuoteId": "mock-id",
        "relistAllItems": false
      },
      "expected": {
        "contractCancellationReason": "BUYER_REQUESTED",
        "purchaseQuoteId": "mock-id",
        "relistAllItems": false
      }
    },
    {
      "label": "relist all items true",
      "input": {
        "contractCancellationReason": "OUT_OF_STOCK",
        "purchaseQuoteId": "pq-123",
        "relistAllItems": true
      },
      "expected": {
        "contractCancellationReason": "OUT_OF_STOCK",
        "purchaseQuoteId": "pq-123",
        "relistAllItems": true
      }
    },
    {
      "label": "default relistAllItems",
      "input": {
        "contractCancellationReason": "BUYER_REQUESTED",
        "purchaseQuoteId": "pq-456"
      },
      "expected": {
        "contractCancellationReason": "BUYER_REQUESTED",
        "purchaseQuoteId": "pq-456",
        "relistAllItems": false
      }
    }
  ]
}
