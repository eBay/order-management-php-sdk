{
  "cases": [
    {
      "label": "minimal — empty logisticsOptions",
      "input": {
        "lineItems": [
          {
            "itemCommitmentId": "mock-id"
          }
        ],
        "logisticsOptions": {}
      },
      "expected": {
        "lineItems": [
          {
            "itemCommitmentId": "mock-id"
          }
        ],
        "logisticsOptions": {},
        "emailCopyToSeller": false
      }
    },
    {
      "label": "with shipping logistics option",
      "input": {
        "lineItems": [
          {
            "itemCommitmentId": "item-123"
          }
        ],
        "logisticsOptions": {
          "shipping": [
            {
              "cost": {
                "currency": "USD",
                "value": "5.99"
              },
              "shippingServiceCode": "USPS_PRIORITY"
            }
          ]
        },
        "emailCopyToSeller": true
      },
      "expected": {
        "lineItems": [
          {
            "itemCommitmentId": "item-123"
          }
        ],
        "logisticsOptions": {
          "shipping": [
            {
              "cost": {
                "currency": "USD",
                "value": "5.99"
              },
              "shippingServiceCode": "USPS_PRIORITY"
            }
          ]
        },
        "emailCopyToSeller": true
      }
    },
    {
      "label": "with total and message",
      "input": {
        "lineItems": [
          {
            "itemCommitmentId": "item-456"
          }
        ],
        "logisticsOptions": {},
        "messageToBuyer": "Thank you for your order!",
        "total": {
          "additionalCharge": {
            "currency": "USD",
            "value": "2.00"
          }
        }
      },
      "expected": {
        "lineItems": [
          {
            "itemCommitmentId": "item-456"
          }
        ],
        "logisticsOptions": {},
        "emailCopyToSeller": false,
        "messageToBuyer": "Thank you for your order!",
        "total": {
          "additionalCharge": {
            "currency": "USD",
            "value": "2.00"
          }
        }
      }
    }
  ]
}
