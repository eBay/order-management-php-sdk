{
  "cases": [
    {
      "label": "minimal update",
      "input": {
        "updates": [
          {
            "purchaseQuoteId": "mock-id"
          }
        ]
      },
      "expected": {
        "updates": [
          {
            "purchaseQuoteId": "mock-id",
            "emailCopyToSeller": false
          }
        ]
      }
    },
    {
      "label": "update with empty logisticsOptions",
      "input": {
        "updates": [
          {
            "purchaseQuoteId": "pq-123",
            "logisticsOptions": {}
          }
        ]
      },
      "expected": {
        "updates": [
          {
            "purchaseQuoteId": "pq-123",
            "emailCopyToSeller": false,
            "logisticsOptions": {}
          }
        ]
      }
    },
    {
      "label": "update with line items and email copy",
      "input": {
        "updates": [
          {
            "purchaseQuoteId": "pq-456",
            "emailCopyToSeller": true,
            "lineItems": [
              {
                "itemCommitmentId": "item-1"
              }
            ]
          }
        ]
      },
      "expected": {
        "updates": [
          {
            "purchaseQuoteId": "pq-456",
            "emailCopyToSeller": true,
            "lineItems": [
              {
                "itemCommitmentId": "item-1"
              }
            ]
          }
        ]
      }
    }
  ]
}
