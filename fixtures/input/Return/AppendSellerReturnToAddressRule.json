{
  "cases": [
    {
      "label": "with conditionSet",
      "input": {
        "addressRoute": {
          "returnToAddressRoutingStrategy": "RETURN_TO_ADDRESS_CLOSEST_TO_BUYER"
        },
        "conditionSet": {
          "operator": "AND",
          "ruleConditions": [{"type": "MARKETPLACE"}]
        },
        "name": "mock"
      },
      "expected": {
        "name": "mock",
        "addressRoute": {
          "returnToAddressRoutingStrategy": "RETURN_TO_ADDRESS_CLOSEST_TO_BUYER"
        },
        "conditionSet": {
          "operator": "AND",
          "ruleConditions": [{"type": "MARKETPLACE"}]
        }
      }
    },
    {
      "label": "without conditionSet",
      "input": {
        "addressRoute": {
          "returnToAddressRoutingStrategy": "RETURN_TO_SELLER_ADDRESS"
        },
        "name": "my-address-rule"
      },
      "expected": {
        "name": "my-address-rule",
        "addressRoute": {
          "returnToAddressRoutingStrategy": "RETURN_TO_SELLER_ADDRESS"
        }
      }
    },
    {
      "label": "with addressId",
      "input": {
        "addressRoute": {
          "returnToAddressRoutingStrategy": "RETURN_TO_SPECIFIC_ADDRESS",
          "addressId": "addr-123"
        },
        "name": "specific-address-rule"
      },
      "expected": {
        "name": "specific-address-rule",
        "addressRoute": {
          "returnToAddressRoutingStrategy": "RETURN_TO_SPECIFIC_ADDRESS",
          "addressId": "addr-123"
        }
      }
    }
  ]
}
