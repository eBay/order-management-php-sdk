{
  "cases": [
    {
      "label": "with single line item",
      "input": {
        "returnLineItemInput": [
          {
            "orderLineItemId": "mock-id",
            "quantityReturned": 0,
            "returnReason": "COUNTERFEIT"
          }
        ]
      },
      "expected": {
        "returnLineItemInput": [
          {
            "orderLineItemId": "mock-id",
            "returnReason": "COUNTERFEIT",
            "quantityReturned": 0
          }
        ]
      }
    },
    {
      "label": "with note",
      "input": {
        "returnLineItemInput": [
          {
            "orderLineItemId": "li-123",
            "returnReason": "DAMAGED",
            "quantityReturned": 2,
            "returnNote": "Item arrived broken"
          }
        ]
      },
      "expected": {
        "returnLineItemInput": [
          {
            "orderLineItemId": "li-123",
            "returnReason": "DAMAGED",
            "quantityReturned": 2,
            "returnNote": "Item arrived broken"
          }
        ]
      }
    },
    {
      "label": "default quantityReturned",
      "input": {
        "returnLineItemInput": [
          {
            "orderLineItemId": "li-456",
            "returnReason": "WRONG_ITEM"
          }
        ]
      },
      "expected": {
        "returnLineItemInput": [
          {
            "orderLineItemId": "li-456",
            "returnReason": "WRONG_ITEM",
            "quantityReturned": 1
          }
        ]
      }
    }
  ]
}
