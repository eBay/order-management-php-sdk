            }
          ],
          "shippedAt": "2024-06-01T10:00:00.000Z"
        }
      },
      "expected": {
        "cancellationId": "cancel-456",
        "fulfillmentDetails": {
          "shipmentTrackingDetails": [
            {
              "shipmentTrackingNumber": "1Z999AA10123456784",
              "shippingCarrierCode": "UPS"
            }
          ],
          "shippedAt": "2024-06-01T10:00:00.000Z"
        }
      }
    }
  ]
