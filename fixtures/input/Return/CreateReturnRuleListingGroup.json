{
  "cases": [
    {
      "label": "with groupName and listingIds",
      "input": {
        "groupName": "mock",
        "listingIds": ["mock-id"]
      },
      "expected": {
        "groupName": "mock",
        "listingIds": ["mock-id"]
      }
    },
    {
      "label": "empty listingIds",
      "input": {
        "groupName": "empty-group"
      },
      "expected": {
        "groupName": "empty-group",
        "listingIds": []
      }
    },
    {
      "label": "multiple listing ids",
      "input": {
        "groupName": "multi-group",
        "listingIds": ["l-1", "l-2", "l-3"]
      },
      "expected": {
        "groupName": "multi-group",
        "listingIds": ["l-1", "l-2", "l-3"]
      }
    }
  ]
}
